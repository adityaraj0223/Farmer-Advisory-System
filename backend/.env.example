SECRET_KEY="replace-with-a-secure-production-secret-key-32-chars-minimum"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Optional Hosted AI LLM Provider (Managed securely on backend; never exposed to browser)
GEMINI_API_KEY=""

